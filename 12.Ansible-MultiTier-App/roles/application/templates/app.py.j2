import os
from flask import Flask, request, jsonify
from flask_cors import CORS
import mysql.connector

app = Flask(__name__)
CORS(app)

DB_CONFIG = {
    'host': '{{ db_host }}',
    'user': '{{ db_user }}',
    'password': '{{ db_pass }}',
    'database': '{{ db_name }}'
}

def get_db_connection():
    return mysql.connector.connect(**DB_CONFIG)

@app.route('/health', methods=['GET'])
def health():
    return jsonify({"service": "todo-api", "status": "healthy"}), 200

@app.route('/api/tasks', methods=['GET'])
def get_tasks():
    conn = get_db_connection()
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT id, title, description, status, created_at FROM tasks;")
    tasks = cursor.fetchall()
    cursor.close()
    conn.close()
    for task in tasks:
        if task.get('created_at'):
            task['created_at'] = str(task['created_at'])
    return jsonify(tasks), 200

@app.route('/api/tasks', methods=['POST'])
def create_task():
    data = request.get_json() or {}
    title = data.get('title')
    description = data.get('description', '')
    status = data.get('status', 'pending')
    
    if not title:
        return jsonify({"error": "Title is required"}), 400
        
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO tasks (title, description, status) VALUES (%s, %s, %s);",
        (title, description, status)
    )
    conn.commit()
    new_id = cursor.lastrowid
    cursor.close()
    conn.close()
    
    return jsonify({"id": new_id, "title": title, "description": description, "status": status}), 201

if __name__ == '__main__':
    app.run(host='0.0.0.0', port={{ app_port }})
